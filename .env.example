# Discord bot token (Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token

# Google AI Studio / Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional: override the primary Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: channel where Fahim responds to every human message
FAHIM_CHANNEL_ID=1320069245232742588

# Local Lavalink music server (independent of Gemini)
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=fahim-local-node-password

# Optional Spotify link support through LavaSrc (not AI credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
