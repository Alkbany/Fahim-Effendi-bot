# Required: Discord bot token (Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token

# Required: Google AI Studio / Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# Required: MongoDB Atlas or self-hosted connection string
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional Gemini models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional: channel where Fahim responds to every human message
FAHIM_CHANNEL_ID=1320069245232742588

# Optional external Lavalink v4 node. Leave BOTH blank to disable music.
# Use the host and port shown by your Lavalink provider; include http:// or https://.
LAVALINK_URI=https://your-lavalink-host:port
LAVALINK_PASSWORD=use-the-same-strong-secret-as-lavalink-server-password
LAVALINK_IDENTIFIER=fahim-primary

# Optional web-search tuning (DDGS uses multiple providers in auto mode).
DDGS_BACKEND=auto
DDGS_REGION=wt-wt
